{
    "name": "signula/signula-id",
    "description": "SIGNula Universal Authentication System",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "MWBM Partners Ltd",
            "email": "dev@mwbmpartners.com"
        }
    ],
    "require": {
        "php": ">=8.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0",
        "phpstan/phpstan": "^1.10",
        "squizlabs/php_codesniffer": "^3.7",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan-strict-rules": "^1.5"
    },
    "autoload": {
        "psr-4": {
            "SIGNula\\": "private_html/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SIGNula\\Tests\\": "_tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite='Unit Tests'",
        "test:integration": "phpunit --testsuite='Integration Tests'",
        "test:coverage": "phpunit --coverage-html _coverage/html",
        "analyze": "phpstan analyze",
        "check-style": "phpcs",
        "fix-style": "phpcbf",
        "quality": [
            "@check-style",
            "@analyze",
            "@test"
        ]
    },
    "scripts-descriptions": {
        "test": "Run all tests",
        "test:unit": "Run only unit tests",
        "test:integration": "Run only integration tests",
        "test:coverage": "Generate code coverage report",
        "analyze": "Run static analysis with PHPStan",
        "check-style": "Check code style with PHP_CodeSniffer",
        "fix-style": "Auto-fix code style issues",
        "quality": "Run all quality checks (style, analysis, tests)"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
