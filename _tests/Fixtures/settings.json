{
    "security.password.min_length": 12,
    "security.password.require_uppercase": true,
    "security.password.require_lowercase": true,
    "security.password.require_numbers": true,
    "security.password.require_symbols": true,
    "security.login.max_attempts": 5,
    "security.login.lockout_duration": 1800,
    "security.session.lifetime": 3600,
    "security.session.regenerate_interval": 1800,
    "auth.passwordless.enabled": true,
    "auth.passwordless.token_validity": 15,
    "auth.webauthn.enabled": true,
    "auth.webauthn.rp_name": "SIGNula Test",
    "auth.webauthn.rp_id": "localhost",
    "auth.mfa.enabled": true,
    "auth.mfa.totp_issuer": "SIGNula Test",
    "site.url": "http://localhost",
    "site.name": "SIGNula Test",
    "app.name": "SIGNula",
    "app.version": "2.5.0-beta",
    "email_verification.required": true,
    "email_verification.token_lifetime_days": 7,
    "email_verification.allow_login_unverified": true,
    "rate_limiting.enabled": true,
    "rate_limiting.default_limit": 100,
    "rate_limiting.default_window": 3600,

    "captcha.enabled": false,
    "captcha.provider": "none",
    "captcha.turnstile.site_key": "",
    "captcha.turnstile.secret_key": "",
    "captcha.recaptcha.site_key": "",
    "captcha.recaptcha.secret_key": "",
    "captcha.recaptcha.min_score": 0.5,
    "captcha.required_forms": "[\"login\",\"register\",\"forgot-password\",\"contact\"]",

    "security.ip_reputation.enabled": false,
    "security.ip_reputation.abuseipdb_api_key": "",
    "security.ip_reputation.proxycheck_api_key": "",
    "security.ip_reputation.abuse_score_threshold": 50,
    "security.ip_reputation.block_proxy": true,
    "security.ip_reputation.block_vpn": false,
    "security.ip_reputation.block_tor": true,
    "security.ip_reputation.cache_ttl_hours": 24,
    "security.ip_reputation.whitelist": "[]",
    "security.ip_reputation.report_enabled": false,

    "security.bot_detection.enabled": true,
    "security.bot_detection.block_bad_bots": true,
    "security.bot_detection.allow_good_bots": true,
    "security.bot_detection.dns_verify": false,
    "security.bot_detection.block_empty_ua": false,

    "security.session_fingerprinting.enabled": true,
    "security.session_fingerprinting.ip_match": "subnet",
    "security.session_fingerprinting.salt": "test-session-salt-for-unit-tests-only",
    "security.session_fingerprinting.on_mismatch": "invalidate",

    "security.alerts.enabled": true,
    "security.alerts.admin_emails": "[]",
    "security.alerts.notify_threshold": "high",
    "security.alerts.brute_force_threshold": 5,
    "security.alerts.impossible_travel_km": 500,
    "security.alerts.impossible_travel_minutes": 60,
    "security.alerts.password_spray_threshold": 10,
    "security.alerts.password_spray_window_minutes": 30,

    "mfa.otp.lifetime": 900,

    "security.form_protection.enabled": true,
    "security.form_protection.min_submit_time": 3,

    "avatar.max_file_size": 2097152,
    "avatar.allowed_types": "[\"image/jpeg\",\"image/png\",\"image/gif\",\"image/webp\"]",
    "avatar.max_dimensions": 2048,
    "avatar.output_size": 256,
    "avatar.output_format": "webp",
    "avatar.output_quality": 85,
    "avatar.fallback_services": "[\"gravatar\",\"ui_avatars\"]",
    "avatar.gravatar.default": "mp",
    "avatar.cache_external_ttl": 3600,
    "avatar.enable_upload": "1",
    "avatar.proxy_external": "0"
}
