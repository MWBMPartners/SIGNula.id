{
  "permissions": {
    "allow": [
      "Bash(cd:*)"
    ]
  },
  "enabledPlugins": {
    "dev-team@dev-team": true,
    "codex@openai-codex": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/session-watchdog.sh\" 2>/dev/null || true",
            "timeout": 15,
            "statusMessage": "Watchdog: checking for unfinished work…"
          }
        ]
      }
    ]
  }
}
