# PHPStan Configuration for SIGNula
# Static analysis tool for finding bugs in PHP code
#
# Usage:
#   vendor/bin/phpstan analyze
#
# Installation:
#   composer require --dev phpstan/phpstan

parameters:
    # Analysis level (0-9, 9 is strictest)
    level: 6

    # Paths to analyze
    # 📁 Real source roots live under web/ (not the repo root)
    paths:
        - web/private_html
        - web/public_html
        - web/_config
        - web/_includes

    # Paths to exclude from analysis
    excludePaths:
        - web/private_html/layout
        - web/public_html/*/assets
        - vendor

    # 🔍 Scan (but don't report on) these dirs so PHPStan can DISCOVER the
    #    require-based class/function symbols at parse time. Without this,
    #    PHPStan emits ~1900 false "unknown class Database / unknown function"
    #    errors because the app autoloads via require/include, not Composer PSR-4.
    #    See: https://phpstan.org/config-reference#discovering-symbols
    scanDirectories:
        - web/private_html
        - web/_config
        - web/_includes
        - web/_lib
        - web/_backend

    # Bootstrap file for analysis
    # 🚀 Defines SIGNULA_INIT and stubs the global helper functions
    #    (getSetting, getClientIP, redirect, jsonResponse, etc.) so they
    #    resolve during analysis. See _tests/bootstrap.php.
    bootstrapFiles:
        - _tests/bootstrap.php

    # Ignore errors
    ignoreErrors:
        # Allow mixed return types for legacy code
        - '#Function .* has no return type specified#'
        # Allow dynamic properties for database results
        - '#Access to an undefined property mysqli_result::\$#'

    # Check missing types
    checkMissingIterableValueType: false

    # Report unused private methods/properties
    checkUninitializedProperties: true
    checkTooWideReturnTypesInProtectedAndPublicMethods: true

    # Treat PHP superglobals correctly
    universalObjectCratesClasses:
        - stdClass

    # Custom rules
    reportUnmatchedIgnoredErrors: false
